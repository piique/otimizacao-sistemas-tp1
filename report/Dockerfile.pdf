FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        pandoc \
        texlive-xetex \
        texlive-latex-recommended \
        texlive-latex-extra \
        texlive-fonts-recommended \
        lmodern \
        fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /data
ENTRYPOINT ["pandoc"]
